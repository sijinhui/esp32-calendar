<view class="page">
  <view wx:if="{{error}}" class="card warn">{{error}}</view>

  <!-- 第 1 步：搜索设备 -->
  <block wx:if="{{step === 'scan'}}">
    <view class="section-title">附近的日历设备</view>
    <view class="card">
      <view class="list-item" wx:for="{{devices}}" wx:key="deviceId" data-index="{{index}}" bindtap="onPickDevice"
            hover-class="btn-hover">
        <view>
          <view>{{item.name || '日历设备'}}</view>
          <view class="muted">{{item.online ? '已联网 ' + item.ip : item.provisioning ? '配网模式' : ''}}</view>
        </view>
        <text class="muted">{{connecting === item.deviceId ? '连接中…' : item.rssi + ' dBm'}}</text>
      </view>
      <view wx:if="{{!devices.length}}" class="muted">{{scanning ? '正在搜索…' : '没有搜到设备'}}</view>
    </view>
    <view class="muted tips">
      设备第一次开机、或者连不上 WiFi 时会自动进入配网模式。已经联网的设备要重新配网，请先长按设备上的 BOOT 键 3 秒。
    </view>
    <view class="btn {{scanning ? 'disabled' : ''}}" hover-class="btn-hover" bindtap="startScan">
      {{scanning ? '搜索中…' : '重新搜索'}}
    </view>
  </block>

  <!-- 第 2 步：选择 WiFi -->
  <block wx:if="{{step === 'wifi'}}">
    <view wx:if="{{!provisioningMode}}" class="card warn">
      设备当前不在配网模式，修改 WiFi 前请先长按设备上的 BOOT 键 3 秒。
    </view>
    <view class="section-title row">
      <text>{{deviceName}} 附近的 WiFi（只支持 2.4GHz）</text>
      <text class="link" bindtap="scanWifi">{{wifiScanning ? '扫描中…' : '刷新'}}</text>
    </view>
    <view class="card aps">
      <view class="list-item" wx:for="{{aps}}" wx:key="ssid" data-index="{{index}}" bindtap="onPickAp"
            hover-class="btn-hover">
        <text class="{{item.ssid === ssid ? 'selected' : ''}}">{{item.ssid}}</text>
        <text class="muted">{{item.secure ? '加密' : '开放'}} · {{item.rssi}} dBm</text>
      </view>
      <view wx:if="{{!aps.length}}" class="muted">{{wifiScanning ? '设备正在扫描…' : '没有扫描到 WiFi'}}</view>
    </view>

    <view class="card">
      <input class="field" placeholder="WiFi 名称" value="{{ssid}}" maxlength="32" bindinput="onSsid" />
      <view class="password">
        <input class="field" placeholder="密码（没有密码就留空）" password="{{!showPassword}}" value="{{password}}"
               maxlength="63" bindinput="onPassword" />
        <text class="link eye" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>
      <view class="btn primary {{joining ? 'disabled' : ''}}" hover-class="btn-hover" bindtap="onJoin">
        {{joining ? '设备正在连接 WiFi…' : '连接'}}
      </view>
    </view>
  </block>

  <!-- 第 3 步：完成 -->
  <block wx:if="{{step === 'done'}}">
    <view class="card">
      <view class="title ok">设备已连上 WiFi</view>
      <view class="muted done-text">
        设备 IP：{{ip}}。设备会自动对时、同步节假日和日历。手机和设备在同一个 WiFi 时，可以在首页查看画面、添加日历订阅。
      </view>
    </view>
    <view class="actions">
      <view class="btn" hover-class="btn-hover" bindtap="goCalendars">添加日历订阅</view>
      <view class="btn primary" hover-class="btn-hover" bindtap="onDone">完成</view>
    </view>
  </block>
</view>
