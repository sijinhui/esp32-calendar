BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//esp32-calendar//sample//CN
X-WR-CALNAME:示例日历
X-WR-TIMEZONE:Asia/Shanghai
BEGIN:VEVENT
UID:weekly-sync@example
DTSTART;TZID=Asia/Shanghai:20260902T093000
DTEND;TZID=Asia/Shanghai:20260902T103000
RRULE:FREQ=WEEKLY;BYDAY=WE
SUMMARY:产品周会
END:VEVENT
BEGIN:VEVENT
UID:dentist@example
DTSTART:20261014T060000Z
DTEND:20261014T070000Z
SUMMARY:牙医复诊
LOCATION:口腔医院
END:VEVENT
BEGIN:VEVENT
UID:mom-birthday@example
DTSTART;VALUE=DATE:19651015
DTEND;VALUE=DATE:19651016
RRULE:FREQ=YEARLY
SUMMARY:妈妈生日 🎂
END:VEVENT
BEGIN:VEVENT
UID:badminton@example
DTSTART;TZID=Asia/Shanghai:20261016T190000
DTEND;TZID=Asia/Shanghai:20261016T210000
SUMMARY:羽毛球
END:VEVENT
BEGIN:VEVENT
UID:trip@example
DTSTART;VALUE=DATE:20261017
DTEND;VALUE=DATE:20261019
SUMMARY:周末去杭州
END:VEVENT
BEGIN:VEVENT
UID:review@example
DTSTART;TZID=Asia/Shanghai:20261020T100000
DTEND;TZID=Asia/Shanghai:20261020T113000
SUMMARY:季度汇报（准备 PPT 和数据）
END:VEVENT
BEGIN:VEVENT
UID:rent@example
DTSTART;VALUE=DATE:20260105
RRULE:FREQ=MONTHLY
SUMMARY:交房租
END:VEVENT
END:VCALENDAR
